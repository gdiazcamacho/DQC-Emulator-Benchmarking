# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pdb
*.egg-info/
.ipynb_checkpoints/

# ── Conda / virtual environments ──────────────────────────────────────────────
.conda/
.venv/

# ── SLURM: generated job scripts and their output logs ────────────────────────
# job_creator.py writes these; they are reproducible from sweep_params.yaml.
emulators/*/jobs/*.sh
emulators/*/jobs/*.out
emulators/*/jobs/*.err
# SquidASM also writes timestamp-named network configs into jobs/ at runtime
emulators/squidasm/jobs/*-config.yaml
# Stray swap files
emulators/*/jobs/*.swp

# ── Results (large data; not committed) ───────────────────────────────────────
emulators/*/results/*.csv
emulators/*/results/*.json
emulators/*/results/*.npy

# ── CUNQA: per-run backend JSONs written next to the scripts ────────────────
emulators/cunqa/backends/

# ── SquidASM runtime artefact ─────────────────────────────────────────────────
# The live network config is auto-generated from config_template.yaml at runtime.
emulators/squidasm/scripts/.config_file.yaml

# ── Scratch / local-only ──────────────────────────────────────────────────────
scratch/
tmp/
*.log
tree.py
tree_folders.py
create_folder_structure.sh
*_local.ipynb
sweep_params_old.yaml

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# ── Keep these placeholder directories ────────────────────────────────────────
!configs/.gitkeep
!scripts/.gitkeep
!emulators/*/jobs/.gitkeep
!emulators/*/results/.gitkeep
